------------------------------------------------- mata (type end to exit) ------------------------------------------------------------------------------------------------------------------------------
: // data from two Ki x Kj tables (rows: item i's category)
: void mc_data(real matrix n0, real matrix n1, real colvector yi, real colvector yj, real colvector x)
> {
>     real scalar g, r, c
>     real matrix n
> 
>     yi = J(0, 1, .)
>     yj = J(0, 1, .)
>     x  = J(0, 1, .)
>     for (g = 0; g <= 1; g++) {
>         n = (g == 0 ? n0 : n1)
>         for (r = 1; r <= rows(n); r++) {
>             for (c = 1; c <= cols(n); c++) {
>                 yi = yi \ J(n[r, c], 1, r - 1)
>                 yj = yj \ J(n[r, c], 1, c - 1)
>                 x  = x  \ J(n[r, c], 1, g)
>             }
>         }
>     }
> }

: 
: 
: // The production pooled evaluator wrapped to print one line per evaluation. Prints
: //   TR|<rho %21.16f>|<x>|<usable>|<S/N>|<c>|<tau_S>   (each element %12.5e) and returns e unchanged.
: real rowvector tr_eval(real scalar rho, real matrix n, real colvector a, real colvector b)
> {
>     real rowvector e
>     real scalar j
> 
>     e = dwlsmv_cx_rf_eval(rho, n, a, b)
>     printf("TR|%21.16f", rho)
>     for (j = 1; j <= cols(e); j++) {
>         printf("|%12.5e", e[j])
>     }
>     printf("\n")
>     return(e)
> }

: 
: // One case: item fits, the tables and shifted bounds exactly as dwlsmv_cx_pair_fit() builds them,
: // then the production root finder with the pair fit's arguments (B = 0.999, caps 40 and 54).
: void tr_case(real matrix n0, real matrix n1, string scalar tag)
> {
>     real colvector yi, yj, x, thi, thj, ti, tj, ai, bj
>     real matrix    m0, m1
>     real rowvector r
>     real scalar    it, Ki, Kj
> 
>     mc_data(n0, n1, yi, yj, x)
>     Ki  = rows(n0)
>     Kj  = cols(n0)
>     it  = .
>     thi = dwlsmv_cx_item_fit(yi, x, Ki, 1, it)
>     thj = dwlsmv_cx_item_fit(yj, x, Kj, 2, it)
>     ti  = thi[|1 \ Ki - 1|]
>     tj  = thj[|1 \ Kj - 1|]
>     m0  = dwlsmv_crosstab(select(yi, x :== 0), select(yj, x :== 0), Ki, Kj)
>     m1  = dwlsmv_crosstab(select(yi, x :== 1), select(yj, x :== 1), Ki, Kj)
>     ai  = (ti \ (ti :- thi[Ki]))
>     bj  = (tj \ (tj :- thj[Kj]))
>     printf("TR|%s\n", tag)
>     printf("TR|items i|%s\n", invtokens(strofreal(thi', "%21.16f")))
>     printf("TR|items j|%s\n", invtokens(strofreal(thj', "%21.16f")))
>     r = dwlsmv_rootfind(&tr_eval(), (m0 \ m1), ai, bj, (., .), 0.999, 1000, 54)
>     printf("TR|result|%21.16f|%g|%g\n", r[1], r[2], r[3])
> }
note: variable yi may be used before set.
note: variable yj may be used before set.
note: variable x may be used before set.

: end
