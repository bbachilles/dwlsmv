*! dwlsmv -- Module 11: the invariance() level and its fit
*!
*!     void dwlsmv_m11_fit_g(string scalar canon, string scalar level)
*!
*! Build step 3 of the group surface (2026-10-12). canon is the configural
*! text from _dwlsmv_translate (";"-separated). No configural fit inside
*! invariance(level) (decided 2026-10-12, user, (a)): the level is generated by
*! dwlsmv_levelgen(conf, K, level) and fitted, nothing else.
*!
*!   text = dwlsmv_levelgen(conf, K, level)
*!   par  = dwls_identify(text, maps, sts);  fit = dwls_fit(sts, par)
*!   dwls_inference(fit)        pooled: weighting (a), T = (N - G)F (spec D8d)
*!
*! Check 11's configural preflight (spec Module 12 check 11; call site decided
*! 2026-10-13, user, P1 (i)) runs first: dwlsmv_dtboundary on the generator's
*! configural table, group by group, before the level is generated and before
*! any fit; a refusal is rc 3498 naming the configural specification.
*!
*! d = 0 (decided 2026-10-12, user, (a); spec Module 12): past configural the
*! previous level is generated and identified, before the fit; equal free-
*! parameter counts mean d = 0. The flag is the local d0 (and dwlsmv_m11_gd0);
*! nothing is stored in e(). The note (text decided 2026-10-12, user) has the
*! equivalence wording only in Result I2's verified case (dwlsmv_m11_fit_g_i2),
*! else the equal-df wording; it is the third element of dwlsmv_m11_gd0.
*!
*! Externals, removed by dwlsmv_m11_clear(): dwlsmv_m11_gtext (the generated
*! text, newline-separated), dwlsmv_m11_gpar, dwlsmv_m11_gfit, dwlsmv_m11_gd0
*! (d0, previous level name). Locals: T3, df, converged, iterations, rank, N,
*! d0, prevlevel. Posting is build step 4.
*!
*! Executed under StataMP 18 on 2026-10-12: tests/unit/test_invariance_flow.do.
*!
*! SPDX-License-Identifier: GPL-3.0-or-later
*! SPDX-FileCopyrightText: 2026 Erik Ruzek

version 16

mata:

void dwlsmv_m11_fit_g(string scalar canon, string scalar level)
{
    struct dwlsmv_stage1 vector sts
    struct dwlsmv_statmap vector maps
    struct dwlsmv_parmap scalar par, parp, parc
    struct dwlsmv_fit scalar fit
    string rowvector levs
    string scalar conf, txt, prev, note, dfs
    real matrix K
    real scalar G, g, N, d0, lp, ver
    pointer() scalar p

    sts  = *findexternal("dwlsmv_m11_st")
    K    = *findexternal("dwlsmv_m11_K")
    G    = rows(sts)
    maps = dwlsmv_statmap(G, 1)
    N    = 0
    for (g = 1; g <= G; g++) {
        maps[g] = sts[g].map
        N       = N + sts[g].N
    }
    conf = subinstr(canon, ";", char(10)) + char(10)

    // check 11's configural preflight (spec Module 12 check 11; call site
    // decided 2026-10-13, user, P1 (i)): the generator's configural table,
    // group by group, before the level is generated and before any fit
    parc = dwls_identify(dwlsmv_levelgen(conf, K, "configural"), maps, sts)
    dwlsmv_dtboundary(parc, "invariance() preflight on the configural specification",
                      "The configural specification is refused before fitting: no invariance level can be tested from it.")

    txt  = dwlsmv_levelgen(conf, K, level)
    par  = dwls_identify(txt, maps, sts)

    levs = ("configural", "thresholds", "metric", "scalar")
    lp   = 0
    for (g = 1; g <= cols(levs); g++) {
        if (levs[g] == level) {
            lp = g
        }
    }
    d0   = 0
    prev = ""
    if (lp > 1) {
        prev = levs[lp - 1]
        parp = dwls_identify(dwlsmv_levelgen(conf, K, prev), maps, sts)
        d0   = (parp.npar == par.npar)
    }

    fit = dwls_fit(sts, par)
    dwls_inference(fit)

    // the d = 0 note (text decided 2026-10-12, user): the equivalence
    // wording only where Result I2 establishes it, else equal df only
    note = ""
    if (d0) {
        dfs = strofreal(fit.T3_df, "%21.0g")
        ver = 0
        if (level == "metric") {
            ver = dwlsmv_m11_fit_g_i2(conf, K)
        }
        if (ver) {
            note = "Note: invariance(metric) is equivalent to invariance(thresholds) for this model, so" + char(10) +
                   "this step adds no testable restriction: both have df = " + dfs + ", and every factor" + char(10) +
                   "has at most one indicator with three or more categories, the case in which the" + char(10) +
                   "equivalence is established." + char(10)
        }
        else {
            note = "Note: invariance(" + level + ") has the same degrees of freedom as invariance(" + prev + ")" + char(10) +
                   "for this model (df = " + dfs + "). Equal degrees of freedom do not by themselves make two" + char(10) +
                   "models equivalent, and equivalence is not established for this pattern." + char(10)
        }
    }

    p = crexternal("dwlsmv_m11_gtext")
    if (p == NULL) {
        p = findexternal("dwlsmv_m11_gtext")
    }
    *p = txt
    p = crexternal("dwlsmv_m11_gpar")
    if (p == NULL) {
        p = findexternal("dwlsmv_m11_gpar")
    }
    *p = par
    p = crexternal("dwlsmv_m11_gfit")
    if (p == NULL) {
        p = findexternal("dwlsmv_m11_gfit")
    }
    *p = fit
    p = crexternal("dwlsmv_m11_gd0")
    if (p == NULL) {
        p = findexternal("dwlsmv_m11_gd0")
    }
    *p = (strofreal(d0), prev, note)

    st_local("N",          strofreal(N, "%21.0g"))
    st_local("T3",         strofreal(fit.T3, "%21.0g"))
    st_local("df",         strofreal(fit.T3_df, "%21.0g"))
    st_local("converged",  strofreal(fit.converged))
    st_local("iterations", strofreal(fit.iterations))
    st_local("rank",       strofreal(par.npar))
    st_local("d0",         strofreal(d0))
    st_local("prevlevel",  prev)
}

// Prints the stored d = 0 note one line per printf: one %s holding several
// char(10)s lets SMCL wrap mid-word (seen 2026-10-12).
void dwlsmv_m11_fit_g_note()
{
    string scalar s
    real scalar k

    s = (*findexternal("dwlsmv_m11_gd0"))[3]
    while ((k = strpos(s, char(10))) > 0) {
        printf("{txt}%s\n", substr(s, 1, k - 1))
        s = substr(s, k + 1, .)
    }
    if (s != "") {
        printf("{txt}%s\n", s)
    }
}

// 1 iff Result I2's verified case: in group 1, every factor has at most one
// indicator with K > 2, and every lambda line of it is free (a fixed row is
// not tied, which changes the step's count), and no factor covariance is fixed
// at a nonzero value (not nested, user 2026-11-02). conf is newline-separated.
real scalar dwlsmv_m11_fit_g_i2(string scalar conf, real matrix K)
{
    string colvector L
    string rowvector w, fac, ind
    real scalar i, f, j, q

    L   = dwlsmv_canon_lines(conf)
    fac = J(1, 0, "")
    ind = J(1, 0, "")
    for (i = 1; i <= rows(L); i++) {
        w = tokens(L[i])
        if (w[1] == "psi" & cols(w) >= 5) {
            if (w[2] != w[3] & w[4] == "fixed" & strtoreal(w[5]) != 0) {
                return(0)
            }
        }
        if (w[1] == "factor" & cols(fac) == 0) {
            fac = w[2..cols(w)]
        }
        if (w[1] == "ind" & cols(ind) == 0) {
            ind = w[2..cols(w)]
        }
    }
    for (f = 1; f <= cols(fac); f++) {
        q = 0
        for (i = 1; i <= rows(L); i++) {
            w = tokens(L[i])
            if (w[1] == "group") {
                if (w[2] == "2") {
                    break
                }
            }
            if (w[1] == "lambda") {
                if (w[2] == fac[f]) {
                    if (w[4] != "free") {
                        return(0)
                    }
                    for (j = 1; j <= cols(ind); j++) {
                        if (ind[j] == w[3]) {
                            q = q + (K[1, j] > 2)
                        }
                    }
                }
            }
        }
        if (q > 1) {
            return(0)
        }
    }
    return(1)
}

end
