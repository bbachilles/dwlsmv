*! Module 2, option B: the bracketed root-finder of derivation @sec-rootfind,
*! against that section's own R results (tests/unit/rootfind_embed.mata,
*! generated by tools/make_rootfind_embed.R and tools/emit_rootfind_embed.R;
*! tests do not call R).
*!
*!   R1  Level R1's FAIL, CTRL and BOUND pairs: the status, and for every root
*!       |rho-hat - rk_rho| within the section's own budget
*!       tau_rho + (1e-15 c + tau_S)/H. BOUND: status 2 at exactly 0.999.
*!   S   One case per status, each forced as the section forces it (a fake
*!       evaluator, a cap, or an exact zero at rho = 0). Status 8 is
*!       CONSTRUCTED, not taken from the section: every point strictly inside
*!       the walk's bracket is declared unusable (the section has no case).
*!   N   The negative controls on all 21 FAIL pairs: a reversed score must not
*!       converge (status 3); a dropped Plackett term may converge, but must
*!       miss rk_rho by more than the budget.
*!   E   The aborts, each at rc 3498: rho = 0 unusable; a supplied bracket
*!       with an unusable end; one not of sign (+, -).
*!
*! Added 2026-10-01, from the end-of-module review's surviving mutants:
*!   C   evaluation counts against R's within 1 (chosen after measuring:
*!       binormal() and pmvnorm() can move a trial point by an ulp);
*!   T   tau_S at R's root against R's, within a derived first-order tolerance;
*!   F   every endpoint end that is not +-B is the usable edge to four ulps;
*!   S   three more section cases: the walk starts from the right probe, the
*!       touching case with both probes negative, and the width condition (a
*!       flat stretch with |S| <= tau_S away from the root must hit the cap);
*!   E   each abort's message, not only its rc.
*! Added 2026-10-02: the both-negative case gets the hole (-0.5, -0.4999), the
*! mirror of the probe-side case, and its end must equal the walk's from
*! -tau_rho/2 exactly (shown to fail with the walk started from +tau_rho/2,
*! which before ended at status 3 with a count within 1 of R's).
*!
*! SPDX-License-Identifier: GPL-3.0-or-later
*! SPDX-FileCopyrightText: 2026 Erik Ruzek

clear all
set more off

foreach f in tests/dwlsmv_assert.mata                  ///
             src/mata/dwlsmv_types.mata                ///
             src/mata/dwlsmv_statmap_build.mata        ///
             src/mata/dwlsmv_pos_rho.mata              ///
             src/mata/dwlsmv_catcounts.mata            ///
             src/mata/dwlsmv_catdegen.mata             ///
             src/mata/dwlsmv_cumprop.mata              ///
             src/mata/dwlsmv_thresholds.mata           ///
             src/mata/dwlsmv_psi_tau_table.mata        ///
             src/mata/dwlsmv_cellprob.mata             ///
             src/mata/dwlsmv_dcellprob_rho.mata        ///
             src/mata/dwlsmv_wmat.mata                 ///
             src/mata/dwlsmv_crosstab.mata             ///
             src/mata/dwlsmv_pairinfo.mata             ///
             src/mata/dwls_polychoric.mata             ///
             tests/unit/rootfind_embed.mata {
    capture noisily do "`f'"
    if _rc {
        display as error "test_rootfind: `f' failed to load"
        exit 9
    }
}

mata:

// ---- the tests' evaluators (the section's rf_fake and dS controls) --------

real matrix dwlsmv_t_dneg(real colvector a, real colvector b, real scalar x)
{
    return(-dwlsmv_dcellprob_rho(a, b, x))
}

// dP_drho without its +phi2(a_{r-1}, b_{s-1}) corner (the section's rf_dP_drop).
real matrix dwlsmv_t_ddrop(real colvector a, real colvector b, real scalar x)
{
    real matrix G, D
    real scalar K1, K2, r, s, p, q

    K1 = rows(a) + 1
    K2 = rows(b) + 1
    G  = J(K1 + 1, K2 + 1, 0)
    for (r = 2; r <= K1; r++) {
        for (s = 2; s <= K2; s++) {
            p = a[r - 1]
            q = b[s - 1]
            G[r, s] = exp(-(p * p - 2 * x * p * q + q * q) / (2 * (1 - x * x))) /
                      (2 * pi() * sqrt(1 - x * x))
        }
    }
    D = J(K1, K2, 0)
    for (r = 1; r <= K1; r++) {
        for (s = 1; s <= K2; s++) {
            D[r, s] = G[r + 1, s + 1] - G[r, s + 1] - G[r + 1, s]
        }
    }
    return(D)
}

real rowvector dwlsmv_t_f1(real scalar x, real matrix n, real colvector a, real colvector b)
{
    if (x >= 0.97 & x <= 0.985) return((x, 0, ., ., .))
    return(dwlsmv_rf_eval(x, n, a, b))
}

real rowvector dwlsmv_t_f2(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2] & x < -0.5) e[3] = -abs(e[3])
    return(e)
}

real rowvector dwlsmv_t_f3(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2] & x < -0.5) e[3] = 0
    return(e)
}

real rowvector dwlsmv_t_f4(real scalar x, real matrix n, real colvector a, real colvector b)
{
    return(dwlsmv_rf_evalp(x, n, a, b, &dwlsmv_t_dneg()))
}

real rowvector dwlsmv_t_f5(real scalar x, real matrix n, real colvector a, real colvector b)
{
    return(dwlsmv_rf_evalp(x, n, a, b, &dwlsmv_t_ddrop()))
}

real rowvector dwlsmv_t_f6(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2] & x == 0) e[3] = 0
    return(e)
}

real rowvector dwlsmv_t_f7(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2]) e[3] = -sign(x) * max((abs(x) * e[4], 2 * e[5]))
    return(e)
}

real rowvector dwlsmv_t_f8(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2] & abs(x) < 1e-6) e[3] = 0
    return(e)
}

real rowvector dwlsmv_t_f9(real scalar x, real matrix n, real colvector a, real colvector b)
{
    external real scalar dwlsmv_t_hlo, dwlsmv_t_hhi
    if (x > dwlsmv_t_hlo & x < dwlsmv_t_hhi) return((x, 0, ., ., .))
    return(dwlsmv_rf_eval(x, n, a, b))
}

real rowvector dwlsmv_t_f10(real scalar x, real matrix n, real colvector a, real colvector b)
{
    if (x == 0) return((x, 0, ., ., .))
    return(dwlsmv_rf_eval(x, n, a, b))
}

real rowvector dwlsmv_t_f11(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    if (x > 0.4999 & x < 0.5) return((x, 0, ., ., .))
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2] & x == 0) e[3] = 0
    return(e)
}

real rowvector dwlsmv_t_f12(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    if (x > -0.5 & x < -0.4999) return((x, 0, ., ., .))
    e = dwlsmv_rf_evalp(x, n, a, b, &dwlsmv_t_dneg())
    if (e[2] & x == 0) e[3] = 0
    return(e)
}

real rowvector dwlsmv_t_f13(real scalar x, real matrix n, real colvector a, real colvector b)
{
    real rowvector e
    e = dwlsmv_rf_eval(x, n, a, b)
    if (e[2] & x >= 0.996 & x <= 0.9975) e[3] = 0.5 * e[5]
    return(e)
}

pointer(real rowvector function) scalar dwlsmv_t_fe(real scalar m)
{
    if (m == 11) return(&dwlsmv_t_f11())
    if (m == 12) return(&dwlsmv_t_f12())
    if (m == 13) return(&dwlsmv_t_f13())
    if (m == 0) return(&dwlsmv_rf_eval())
    if (m == 1) return(&dwlsmv_t_f1())
    if (m == 2) return(&dwlsmv_t_f2())
    if (m == 3) return(&dwlsmv_t_f3())
    if (m == 4) return(&dwlsmv_t_f4())
    if (m == 5) return(&dwlsmv_t_f5())
    if (m == 6) return(&dwlsmv_t_f6())
    if (m == 7) return(&dwlsmv_t_f7())
    if (m == 8) return(&dwlsmv_t_f8())
    if (m == 9) return(&dwlsmv_t_f9())
    return(&dwlsmv_t_f10())
}

// Case k's table and thresholds from the embed.
void dwlsmv_t_case(real scalar k, real matrix T, real matrix H,
                   real matrix n, real colvector a, real colvector b)
{
    real matrix t, h
    real scalar i

    t = select(T, T[., 1] :== k)
    h = select(H, H[., 1] :== k)
    n = J(max(t[., 2]), max(t[., 3]), 0)
    for (i = 1; i <= rows(t); i++) {
        n[t[i, 2], t[i, 3]] = t[i, 4]
    }
    a = select(h[., 4], h[., 2] :== 1)
    b = select(h[., 4], h[., 2] :== 2)
}

// Control (ii)'s end, from the walk started on the right probe (-tau_rho/2), as
// the derivation's assertion does: exact, so no tolerance. Its end cannot be
// compared with R's -- status-3 ends sit where usability flips, and Stata's and
// R's flip points differ by up to 3.6e-4 on these tables (measured 2026-10-02).
// Added 2026-10-02: the walk from +tau_rho/2 meets (-0.5, -0.4999) and ends at
// -0.4999 with status 3 and a count within 1 of R's, which nothing else caught.
real scalar dwlsmv_t_negwalk(real matrix n, real colvector a, real colvector b)
{
    real rowvector e0, ein, eout
    real scalar    st, k

    e0  = dwlsmv_t_f12(0, n, a, b)
    ein = dwlsmv_t_f12(-dwlsmv_rf_taur(e0) / 2, n, a, b)
    st  = dwlsmv_rf_side(&dwlsmv_t_f12(), n, a, b, ein, -1, 0.999, eout, k)
    if (st != 3) {
        errprintf("test_rootfind: control (ii)'s walk returned %f at %21.17g\n", st, ein[1])
        _error("test_rootfind: control (ii)'s walk did not end at the usable end")
    }
    return(ein[1])
}

// The hole case: the walk's bracket on this table, from rho = 0.
void dwlsmv_t_hole(real matrix n, real colvector a, real colvector b)
{
    external real scalar dwlsmv_t_hlo, dwlsmv_t_hhi
    real rowvector e0, ein, eout
    real scalar    st, k

    e0  = dwlsmv_rf_eval(0, n, a, b)
    ein = e0
    st  = dwlsmv_rf_side(&dwlsmv_rf_eval(), n, a, b, ein, sign(e0[3]), 0.999, eout, k)
    if (st != 0) _error("test_rootfind: the hole case's walk found no bracket")
    dwlsmv_t_hlo = min((ein[1], eout[1]))
    dwlsmv_t_hhi = max((ein[1], eout[1]))
}

// The endpoint check's frontier ends (added 2026-10-01): where an end is not
// +-B it must be the usable edge to four ulps, so some double within a few
// ulps beyond it is unusable. Returns how many frontier ends were checked.
real scalar dwlsmv_t_frontier(real matrix n, real colvector a, real colvector b,
                              real scalar rho, string colvector FAIL, string scalar id)
{
    real rowvector e, ee
    real scalar    d, kk, j, found, u, cnt, capped

    e   = dwlsmv_rf_eval(rho, n, a, b)
    cnt = 0
    for (d = -1; d <= 1; d = d + 2) {
        capped = dwlsmv_rf_end(&dwlsmv_rf_eval(), n, a, b, d, 0.999, e, 54, ee, kk)
        if (ee[1] == d * 0.999) continue
        cnt   = cnt + 1
        found = 0
        u     = dwlsmv_rf_ulp(ee[1])
        for (j = 1; j <= 8; j++) {
            if (!dwlsmv_rf_eval(ee[1] + d * j * u, n, a, b)[2]) {
                found = 1
                break
            }
        }
        if (!found | capped) {
            FAIL = FAIL \ ("frontier " + id + ": the end " + strofreal(ee[1], "%21.17g") +
                           " is not the usable edge to four ulps")
        }
    }
    return(cnt)
}

// tau_S at R's own root, against R's value (added 2026-10-01). DERIVED
// tolerance, first order: the computed cell probabilities of the two
// implementations differ by at most delta_P each, which moves each term of
// tau_S (through u = D/pi and 1/pi) by at most ~2 delta_P / pi_min relative;
// the densities' own rounding adds a few eps. So 4 delta_P / pi_min + 64 eps.
void dwlsmv_t_taus(real matrix n, real colvector a, real colvector b, real scalar x,
                   real scalar tauR, string colvector FAIL, string scalar id,
                   real scalar maxtau)
{
    real rowvector e
    real matrix    P
    real scalar    pmin, tol, q

    e    = dwlsmv_rf_eval(x, n, a, b)
    P    = dwlsmv_cellprob_raw(a, b, x)
    pmin = min(select(vec(P), vec(n) :> 0))
    tol  = (4 * dwlsmv_rf_dP() / pmin + 64 * epsilon(1)) * tauR
    q    = abs(e[5] - tauR) / tol
    maxtau = max((maxtau, q))
    if (q > 1 | e[5] >= .) {
        FAIL = FAIL \ ("tau_S " + id + ": " + strofreal(q) + " of its tolerance")
    }
}

real scalar dwlsmv_t_rootfind()
{
    string colvector id, set, FAIL
    real matrix      M, T, H, n
    real colvector   a, b, seen
    real rowvector   r
    real scalar      k, m, ok, dev, maxdev, maxev, st, nfr, maxtau

    dwlsmv_t_rf_embed(id, set, M, T, H)
    FAIL   = J(0, 1, "")
    seen   = J(8, 1, 0)
    maxdev = 0
    maxev  = 0
    nfr    = 0
    maxtau = 0
    printf("{txt}test_rootfind: %f cases from the section\n", rows(M))

    for (k = 1; k <= rows(M); k++) {
        dwlsmv_t_case(k, T, H, n, a, b)
        m = M[k, 9]
        if (m == 9) dwlsmv_t_hole(n, a, b)
        r = dwlsmv_rootfind(dwlsmv_t_fe(m), n, a, b, M[k, (10, 11)], M[k, 6], M[k, 7], M[k, 8])
        dev = abs(r[3] - (M[k, 12] + (M[k, 13] < . ? M[k, 13] : 0)))
        maxev = max((maxev, dev))
        // Evaluation counts, the endpoint check's and the probes' included.
        // Tolerance 1, CHOSEN AFTER MEASURING (the largest gap on 2026-09-30
        // was 1): binormal() and R's pmvnorm() may move one trial point by an
        // ulp. Added 2026-10-01: unasserted counts let count, probe, step and
        // walk mutations survive. A cap fixes its own count, so status 7
        // must match R exactly.
        if (dev > 1 | (r[2] == 7 & dev != 0)) {
            FAIL = FAIL \ ("count " + id[k] + ": " + strofreal(r[3]) + " evaluations, R " +
                           strofreal(M[k, 12] + (M[k, 13] < . ? M[k, 13] : 0)))
        }
        if (m == 0 & r[2] == 1) {
            nfr = nfr + dwlsmv_t_frontier(n, a, b, r[1], FAIL, id[k])
            dwlsmv_t_taus(n, a, b, M[k, 3], M[k, 14], FAIL, id[k], maxtau)
        }

        if (m == 5) {
            // Dropped term: caught by the comparison, not the algorithm.
            if (r[2] == 1 & abs(r[1] - M[k, 4]) <= M[k, 5]) {
                FAIL = FAIL \ ("N " + id[k] + ": the dropped term's root is within the budget")
            }
            continue
        }
        st = r[2]
        seen[st] = seen[st] + 1
        if (st != M[k, 1]) {
            FAIL = FAIL \ ("status " + id[k] + ": " + strofreal(st) + ", expected " + strofreal(M[k, 1]))
            continue
        }
        if (st == 1 & M[k, 4] < .) {
            dev = abs(r[1] - M[k, 4]) / M[k, 5]
            maxdev = max((maxdev, dev))
            if (dev > 1) {
                FAIL = FAIL \ ("root " + id[k] + ": |rho - rk_rho| is " + strofreal(dev) + " of the budget")
            }
        }
        if (st == 2 & r[1] != M[k, 3]) {
            FAIL = FAIL \ ("bound " + id[k] + ": rho-hat is not the bound")
        }
        if (m == 7 & r[1] != 0) {
            FAIL = FAIL \ ("S0 " + id[k] + ": the crossing zero is not returned at exactly 0")
        }
        if (m == 12) {
            // Nested, not m == 12 & ...: Mata's & evaluates both sides.
            if (dwlsmv_t_negwalk(n, a, b) != r[1]) {
                FAIL = FAIL \ ("S0 " + id[k] + ": the end is not the walk's from -tau_rho/2")
            }
        }
    }
    printf("{txt}  statuses seen (1..8): %s\n", invtokens(strofreal(seen')))
    printf("{txt}  largest |rho - rk_rho| / budget over the roots: %g\n", maxdev)
    printf("{txt}  largest |evaluations - R's| (tolerance 1): %g\n", maxev)
    printf("{txt}  endpoint ends checked at the usable frontier: %g\n", nfr)
    printf("{txt}  largest |tau_S - R's| / its derived tolerance: %g\n", maxtau)
    if (nfr == 0) FAIL = FAIL \ "no endpoint end was a frontier end: the frontier check is vacuous"

    // dwlsmv_rf_ulp at and just below powers of two, where ln()/ln(2) can
    // round across the integer (the review of 2026-10-01 found R's log2 form
    // off by a factor 2 there). Exact: both sides are powers of two.
    for (m = -30; m <= 0; m++) {
        if (dwlsmv_rf_ulp(2^m) != 2^(m - 52) | dwlsmv_rf_ulp(-2^m) != 2^(m - 52) |
            dwlsmv_rf_ulp(2^m * (1 - 2^-53)) != 2^(m - 53)) {
            FAIL = FAIL \ ("ulp: wrong at or just below 2^" + strofreal(m))
        }
    }
    if (any(seen :== 0)) FAIL = FAIL \ "not every status was produced"

    for (k = 1; k <= rows(FAIL); k++) {
        printf("{err}    %s\n", FAIL[k])
    }
    return(rows(FAIL))
}

// The aborts' preconditions, so that an abort is known to be the one intended.
real scalar dwlsmv_t_abortpre()
{
    real matrix    n
    real colvector a, b
    real scalar    xinf, bad
    real rowvector e1, e2

    dwlsmv_t_rf_abortpair(n, a, b, xinf)
    bad = 0
    e1  = dwlsmv_rf_eval(xinf, n, a, b)
    if (e1[2] != 0) {
        printf("{err}    E: the unusable bracket end %g is usable in Stata\n", xinf)
        bad++
    }
    e1 = dwlsmv_rf_eval(0, n, a, b)
    e2 = dwlsmv_rf_eval(0.5, n, a, b)
    if (!(e1[2] & e2[2] & e1[3] > 0 & e2[3] > 0)) {
        printf("{err}    E: the bracket (0, .5) is not positive at both ends\n")
        bad++
    }
    return(bad)
}

void dwlsmv_t_abort(real scalar which)
{
    real matrix    n
    real colvector a, b
    real scalar    xinf
    real rowvector r

    dwlsmv_t_rf_abortpair(n, a, b, xinf)
    if (which == 1) r = dwlsmv_rootfind(&dwlsmv_rf_eval(), n, a, b, (-0.5, xinf), 0.999, 40, 54)
    if (which == 2) r = dwlsmv_rootfind(&dwlsmv_rf_eval(), n, a, b, (0, 0.5), 0.999, 40, 54)
    if (which == 3) r = dwlsmv_rootfind(&dwlsmv_t_f10(), n, a, b, (., .), 0.999, 40, 54)
}

// The public wrapper: status is stored, converged set from it, iterations
// counted in evaluations, on the first FAIL pair's data.
real scalar dwlsmv_t_wrapper()
{
    struct dwlsmv_pairfit scalar f
    real matrix    M, T, H, n, Y
    string colvector id, set
    real colvector a, b
    real rowvector rr
    real scalar    r, s, i, bad

    dwlsmv_t_rf_embed(id, set, M, T, H)
    dwlsmv_t_case(1, T, H, n, a, b)
    Y = J(sum(n), 2, .)
    i = 0
    for (r = 1; r <= rows(n); r++) {
        for (s = 1; s <= cols(n); s++) {
            if (n[r, s]) {
                Y[|i + 1, 1 \ i + n[r, s], 2|] = J(n[r, s], 1, (r - 1, s - 1))
                i = i + n[r, s]
            }
        }
    }
    f = dwls_polychoric(Y[., 1], Y[., 2], a, b)
    printf("{txt}  wrapper: status %g, converged %g, iterations %g, rho %21.17g\n",
           f.status, f.converged, f.iterations, f.rho)
    rr  = dwlsmv_rootfind(&dwlsmv_rf_eval(), n, a, b, (., .), 0.999, 40, 54)
    bad = 0
    if (f.status != 1 | f.converged != 1) bad++
    if (f.converged != (f.status == 1)) bad++
    if (f.rho != rr[1] | f.status != rr[2] | f.iterations != rr[3]) bad++
    if (abs(f.rho - M[1, 4]) > M[1, 5]) bad++
    if (bad) printf("{err}    wrapper: %f check(s) failed\n", bad)
    return(bad)
}

end

local nfail = 0
local nerr  = 0

mata: st_local("nfail", strofreal(dwlsmv_t_rootfind()))
mata: st_local("w", strofreal(dwlsmv_t_wrapper()))
local nfail = `nfail' + `w'
mata: st_local("p", strofreal(dwlsmv_t_abortpre()))
local nfail = `nfail' + `p'

* Each abort must be rc 3498 AND the intended one: its message is captured in
* a scratch log and matched (added 2026-10-01; rc alone let a removed check pass
* through a different check's abort).
local msg1 "dwls_polychoric: unusable bracket end"
local msg2 "dwls_polychoric: bracket not maximum-oriented"
local msg3 "dwls_polychoric: rho = 0 is not usable"
tempfile ablog
forvalues i = 1/3 {
    quietly log using "`ablog'", text replace name(rfabort)
    capture noisily mata: dwlsmv_t_abort(`i')
    local rc = _rc
    quietly log close rfabort
    if `rc' != 3498 {
        display as error "test_rootfind: abort case `i' gave rc `rc', not 3498"
        local nerr = `nerr' + 1
    }
    mata: st_local("hit", strofreal(any(strpos(cat(st_local("ablog")), st_local("msg`i'")))))
    if !`hit' {
        display as error "test_rootfind: abort case `i' did not report: `msg`i''"
        local nerr = `nerr' + 1
    }
}

if `nfail' | `nerr' {
    display as error _n "test_rootfind: `nfail' numeric failure(s), `nerr' error-path failure(s)"
    exit 9
}
